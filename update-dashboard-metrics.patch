--- HealthShow/src/views/health-monitor/dashboard/dashboard.scss
+++ HealthShow/src/views/health-monitor/dashboard/dashboard.scss
@@ -477,10 +477,12 @@
   --metric-tone: #3eb7ff;
   --metric-tone-soft: rgba(62, 183, 255, 0.4);
   flex:1; display:flex; flex-direction:column; align-items:center; gap:4px;
-  background:rgba(0,212,255,0.04); border:1px solid rgba(0,212,255,0.12);
+  background:var(--metric-tone-soft); 
+  border:1px solid color-mix(in srgb, var(--metric-tone) 20%, transparent);
   border-radius:12px; padding:10px 8px 8px;
   transition:border-color 0.2s, background 0.2s, transform 0.15s;
-  &:hover { border-color:rgba(0,212,255,0.5); background:rgba(0,212,255,0.09); transform:translateY(-1px); }
+  &:hover { border-color:var(--metric-tone); background:color-mix(in srgb, var(--metric-tone) 15%, transparent); transform:translateY(-1px); }
   &:active { transform:translateY(0); }
 }
 .dm-metric-val   { font-size:19px; font-weight:700; font-family:'Consolas',monospace; line-height:1; color: var(--metric-tone); }
-.dm-metric-bar-wrap { width:100%; height:4px; background:rgba(0,212,255,0.1); border-radius:2px; overflow:hidden; }
+.dm-metric-bar-wrap { width:100%; height:4px; background:color-mix(in srgb, var(--text-primary) 10%, transparent); border-radius:2px; overflow:hidden; }
 .dm-metric-bar   { height:100%; border-radius:2px; transition:width 1s ease; min-width:2px; background: var(--metric-tone); }
 .dm-metric-label { font-size:12px; color:$dim; }
 .dm-metric-records { font-size:10px; color:rgba(139,166,200,0.7); margin-top:3px; font-family:'Consolas',monospace; }
-.dm-metric-rec-bar-wrap { width:100%; height:2px; background:rgba(255,255,255,0.05); border-radius:1px; overflow:hidden; margin-top:2px; }
+.dm-metric-rec-bar-wrap { width:100%; height:2px; background:color-mix(in srgb, var(--text-primary) 5%, transparent); border-radius:1px; overflow:hidden; margin-top:2px; }
 .dm-metric-rec-bar { height:100%; border-radius:1px; transition:width 1s ease; min-width:1px; background: var(--metric-tone-soft); }
 .dm-main-metrics-total { white-space:nowrap; }
