<template>
  <div class="dm-outer" @transitionend.stop @animationend.stop>
  <div class="dm-root" ref="dmScale">
    <!-- ═══════════════ 头部 ═══════════════ -->
    <header class="dm-header">
      <div class="dm-header-brand">
        <div class="dm-brand-pulse"></div>
        <div>
          <div class="dm-brand-title">信智科技职业健康监测管理系统</div>
          <div class="dm-brand-time">{{ currentTime }}</div>
        </div>
      </div>

      <!-- 4 个实时 KPI -->
      <div class="dm-header-kpis">
        <div class="dm-kpi kpi-blue">
          <el-icon class="dm-kpi-icon" :size="22"><Monitor /></el-icon>
          <div class="dm-kpi-body">
            <div class="dm-kpi-val">{{ kpiOnline }}</div>
            <div class="dm-kpi-label">当前在线设备</div>
          </div>
          <div class="dm-kpi-dot dot-blue"></div>
        </div>
        <div class="dm-kpi kpi-red">
          <el-icon class="dm-kpi-icon" :size="22"><Warning /></el-icon>
          <div class="dm-kpi-body">
            <div class="dm-kpi-val">{{ warningEvents.length }}</div>
            <div class="dm-kpi-label">本月预警事件</div>
          </div>
          <div class="dm-kpi-dot dot-red"></div>
        </div>
        <div class="dm-kpi kpi-green">
          <el-icon class="dm-kpi-icon" :size="22"><Cellphone /></el-icon>
          <div class="dm-kpi-body">
            <div class="dm-kpi-val">{{ deviceStats.total }}</div>
            <div class="dm-kpi-label">设备总数</div>
          </div>
          <div class="dm-kpi-dot dot-green"></div>
        </div>
        <div class="dm-kpi kpi-orange">
          <el-icon class="dm-kpi-icon" :size="22"><TrendCharts /></el-icon>
          <div class="dm-kpi-body">
            <div class="dm-kpi-val">{{ totalRecords.toLocaleString() }}</div>
            <div class="dm-kpi-label">当月总记录数</div>
          </div>
          <div class="dm-kpi-dot dot-orange"></div>
        </div>
      </div>
    </header>

    <!-- ═══════════════ 主网格 ═══════════════ -->
    <div class="dm-grid">

      <!-- ── A1: 当月检测概览 ── -->
      <div class="dm-card" style="grid-area:a1">
        <div class="dm-card-hd">
          <span class="dm-hd-bar"></span>当月检测概览
          <span class="dm-hd-sub">按指标类型分布</span>
        </div>
        <div class="dm-donut-wrap">
          <div id="checkCountChart" class="dm-chart"></div>
          <div class="dm-donut-center">
            <div class="dm-donut-num">{{ totalRecords }}</div>
            <div class="dm-donut-lbl">总记录</div>
          </div>
        </div>
        <!-- 指标小统计 -->
        <div class="dm-metric-row">
          <div class="dm-metric" v-for="m in metricList" :key="m.key">
            <span class="dm-metric-dot" :style="{background: m.color}"></span>
            <span class="dm-metric-name">{{ m.label }}</span>
            <span class="dm-metric-val">{{ checkData[m.key] || 0 }}</span>
          </div>
        </div>
      </div>

      <!-- ── CENTER: 健康监测中心 (跨两行) ── -->
      <div class="dm-card dm-card-center" style="grid-area:center">
        <div class="dm-card-hd">
          <span class="dm-hd-bar"></span>健康监测中心
          <span class="dm-hd-sub">实时体征综合分析</span>
        </div>
        <!-- 矿工模型区 -->
        <div class="body-model-3d-container">
          <div class="human-body-3d miner-model video-mode">
            <div class="scan-ring"></div>
            <div class="scan-ring scan-ring-2"></div>
            <div class="scan-ring scan-ring-3"></div>
            <div class="miner-video-wrap">
              <video
                class="miner-video"
                src="/miner-worker.mp4"
                autoplay
                loop
                muted
                playsinline
              ></video>
            </div>
            <div class="base-platform">
              <div class="platform-ring"></div>
              <div class="platform-glow"></div>
            </div>
          </div>

          <!-- 四角数据 -->
          <div class="pyramid-data top-left">
            <div class="pd-icon"><el-icon><Moon /></el-icon></div>
            <div class="pd-label">人均睡眠</div>
            <div class="pd-val">{{ bodyIndicators.avgSleep || 0 }}<span class="pd-unit">h</span></div>
          </div>
          <div class="pyramid-data top-right">
            <div class="pd-icon"><el-icon><Trophy /></el-icon></div>
            <div class="pd-label">压力均值</div>
            <div class="pd-val">{{ bodyIndicators.avgPressure || 0 }}</div>
          </div>
          <div class="pyramid-data bottom-left">
            <div class="pd-icon"><el-icon><PieChart /></el-icon></div>
            <div class="pd-label">人均血氧</div>
            <div class="pd-val">{{ bodyIndicators.avgBloodOxygen || 0 }}<span class="pd-unit">%</span></div>
          </div>
          <div class="pyramid-data bottom-right">
            <div class="pd-icon"><el-icon><TrendCharts /></el-icon></div>
            <div class="pd-label">人均心率</div>
            <div class="pd-val">{{ bodyIndicators.avgHeartRate || 0 }}<span class="pd-unit">bpm</span></div>
          </div>

          <!-- 底部步数 -->
          <div class="center-steps">
            <el-icon class="steps-icon"><Promotion /></el-icon>
            <span class="steps-label">人均日步数</span>
            <span class="steps-val">{{ (bodyIndicators.avgSteps || 0).toLocaleString() }}</span>
            <span class="steps-unit">步</span>
          </div>
        </div>

        <!-- 分割线 -->
        <div class="dm-divider"></div>

        <!-- 设备状态区 -->
        <div class="dm-card-hd" style="border-top:none;padding-top:8px">
          <span class="dm-hd-bar"></span>设备状态
          <span class="dm-hd-sub">激活 / 使用 / 预警</span>
        </div>
        <div class="dm-device-body">
          <div class="dm-device-total">
            <div class="dm-device-circle">
              <el-icon :size="26" color="#00d4ff"><Cellphone /></el-icon>
            </div>
            <div class="dm-device-count">{{ deviceStats.total }}</div>
            <div class="dm-device-sub">设备总数</div>
          </div>
          <div class="dm-gauges">
            <div class="dm-gauge-item">
              <div id="activeRateChart" class="dm-gauge-chart"></div>
              <div class="dm-gauge-label">激活率</div>
            </div>
            <div class="dm-gauge-item">
              <div id="usageRateChart" class="dm-gauge-chart"></div>
              <div class="dm-gauge-label">使用率</div>
            </div>
            <div class="dm-gauge-item">
              <div id="warningRateChart" class="dm-gauge-chart"></div>
              <div class="dm-gauge-label">预警率</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── B1: 实时预警动态 ── -->
      <div class="dm-card" style="grid-area:b1">
        <div class="dm-card-hd">
          <span class="dm-hd-bar"></span>实时预警动态
          <span class="dm-badge-count">{{ warningEvents.length }}</span>
        </div>
        <div class="dm-event-list" ref="warningList">
          <div
            v-for="(ev, i) in paginatedWarningEvents" :key="i"
            :class="['dm-event', ev.level === 'danger' ? 'ev-danger' : 'ev-warn']"
          >
            <div class="dm-ev-row1">
              <span :class="['dm-ev-badge', ev.level === 'danger' ? 'badge-danger' : 'badge-warn']">
                {{ ev.level === 'danger' ? '危险' : '预警' }}
              </span>
              <span class="dm-ev-type">{{ ev.type }}</span>
              <span class="dm-ev-time">{{ formatTimeAgo(ev.time) }}</span>
            </div>
            <div class="dm-ev-row2">
              <span class="dm-ev-user">{{ ev.userName }}</span>
              <span class="dm-ev-val">{{ ev.indicator }}: <em>{{ ev.value }}</em></span>
              <span v-if="ev.handled" class="dm-ev-done">✓处理</span>
              <span v-else class="dm-ev-pending">待处理</span>
            </div>
          </div>
          <div v-if="!warningEvents.length" class="dm-empty">暂无预警事件</div>
        </div>
        <div class="dm-event-page" v-if="warningTotalPages > 1">
          <button class="dm-page-btn" :disabled="warningCurrentPage === 1" @click="warningCurrentPage--">‹</button>
          <span class="dm-page-info">{{ warningCurrentPage }} / {{ warningTotalPages }}</span>
          <button class="dm-page-btn" :disabled="warningCurrentPage === warningTotalPages" @click="warningCurrentPage++">›</button>
        </div>
      </div>

      <!-- ── A2: 指标预警率分析 ── -->
      <div class="dm-card" style="grid-area:a2">
        <div class="dm-card-hd">
          <span class="dm-hd-bar"></span>指标预警率分析
          <span class="dm-hd-sub">本月预警占比</span>
        </div>
        <div class="dm-warn-stats">
          <div v-for="item in warningRates" :key="item.name" class="dm-warn-item">
            <div class="dm-warn-icon-wrap">
              <el-icon :size="16"><component :is="getWarningIcon(item.name)" /></el-icon>
            </div>
            <div class="dm-warn-body">
              <div class="dm-warn-top">
                <span class="dm-warn-name">{{ item.name }}</span>
                <span class="dm-warn-pct" :style="{color: getWarnColor(item.rate)}">{{ item.rate }}%</span>
              </div>
              <div class="dm-warn-bar-bg">
                <div class="dm-warn-bar-fill" :style="{width: item.rate + '%', background: getWarnGradient(item.rate)}"></div>
              </div>
            </div>
            <div class="dm-warn-tag" :class="getWarnTagClass(item.rate)">
              {{ getWarnTagLabel(item.rate) }}
            </div>
          </div>
          <div v-if="!warningRates.length" class="dm-empty">暂无数据</div>
        </div>
      </div>

      <!-- ── B2: 数据量 TOP 5 ── -->
      <div class="dm-card" style="grid-area:b2">
        <div class="dm-card-hd">
          <span class="dm-hd-bar"></span>数据量 TOP 5
          <span class="dm-hd-sub">本月使用活跃度排行</span>
        </div>
        <div id="top5Chart" class="dm-chart"></div>
      </div>

    </div><!-- /dm-grid -->
  </div><!-- /dm-root -->
  </div><!-- /dm-outer -->
</template>

<script>
import * as echarts from 'echarts'
import dayjs from 'dayjs'
import {
  getDashboardOverview,
  getBodyIndicators,
  getDataTop5,
  getDeviceActivation,
  getWarningEvents
} from '@/api/health'

export default {
  name: 'HealthDashboard',
  data() {
    return {
      currentTime: '',
      timeInterval: null,
      refreshTimer: null,
      resizeTimer: null,
      pageScrollInterval: null,
      checkData: {},
      bodyIndicators: {},
      top5Data: [],
      warningRates: [],
      deviceStats: { total: 0, activeRate: 0, usageRate: 0, warningRate: 0 },
      warningEvents: [],
      warningCurrentPage: 1,
      warningPageSize: 15,
      charts: {},
      metricList: [
        { key: 'heartRate',   label: '心率', color: '#00d4ff' },
        { key: 'bloodOxygen', label: '血氧', color: '#67C23A' },
        { key: 'sleep',       label: '睡眠', color: '#E6A23C' },
        { key: 'steps',       label: '步数', color: '#F56C6C' },
        { key: 'temperature', label: '体温', color: '#909399' },
        { key: 'pressure',    label: '压力', color: '#00ffff' }
      ]
    }
  },
  computed: {
    totalRecords() {
      const d = this.checkData
      return (d.heartRate || 0) + (d.bloodOxygen || 0) + (d.sleep || 0) +
             (d.steps || 0) + (d.temperature || 0) + (d.pressure || 0)
    },
    kpiOnline() {
      return Math.round(this.deviceStats.total * (this.deviceStats.usageRate || 0) / 100)
    },
    paginatedWarningEvents() {
      const start = (this.warningCurrentPage - 1) * this.warningPageSize
      return this.warningEvents.slice(start, start + this.warningPageSize)
    },
    warningTotalPages() {
      return Math.ceil(this.warningEvents.length / this.warningPageSize)
    }
  },
  mounted() {
    this.initTime()
    this.fetchData()
    this.startAutoRefresh()
    this.setScale()
    this._resizeHandler = () => this.handleResize()
    window.addEventListener('resize', this._resizeHandler)
  },
  activated() {
    this.fetchData()
    this.setScale()
    this.$nextTick(() => {
      Object.values(this.charts).forEach(c => c && c.resize())
    })
  },
  beforeUnmount() {
    clearInterval(this.timeInterval)
    clearInterval(this.refreshTimer)
    clearInterval(this.pageScrollInterval)
    clearTimeout(this.resizeTimer)
    window.removeEventListener('resize', this._resizeHandler)
    Object.values(this.charts).forEach(c => c && c.dispose())
    // 清理 setScale() 设置的内联 transform/width/height
    // 否则这些非标准样式会残留并干扰 Vue Router out-in 过渡，
    // 导致离开 dashboard 后新页面空白（必须刷新才显示）
    const el = this.$refs.dmScale
    if (el) {
      el.style.transform = ''
      el.style.width = ''
      el.style.height = ''
      el.style.transformOrigin = ''
    }
  },
  methods: {
    // ── 时间 ──
    initTime() {
      this.updateTime()
      this.timeInterval = setInterval(this.updateTime, 1000)
    },
    updateTime() {
      this.currentTime = dayjs().format('YYYY年MM月DD日 HH:mm:ss')
    },

    // ── 数据加载 ──
    async fetchData() {
      await Promise.allSettled([
        this.fetchDashboardData(),
        this.fetchBodyIndicators(),
        this.fetchTop5Data(),
        this.fetchDeviceData(),
        this.fetchWarningEvents()
      ])
    },
    async fetchDashboardData() {
      try {
        const res = await getDashboardOverview()
        if (res.code === 200) {
          this.checkData = res.data
          this.$nextTick(() => this.initCheckCountChart())
        }
      } catch (e) {
        this.checkData = {}
        this.$nextTick(() => this.initCheckCountChart())
      }
    },
    async fetchBodyIndicators() {
      try {
        const res = await getBodyIndicators()
        if (res.code === 200) this.bodyIndicators = res.data
      } catch (e) {
        this.bodyIndicators = {}
      }
    },
    async fetchTop5Data() {
      try {
        const res = await getDataTop5()
        if (res.code === 200) {
          this.top5Data = res.data || []
          this.$nextTick(() => this.initTop5Chart())
        }
      } catch (e) {
        this.top5Data = []
        this.$nextTick(() => this.initTop5Chart())
      }
    },
    async fetchDeviceData() {
      try {
        const res = await getDeviceActivation()
        if (res.code === 200) {
          const d = res.data
          this.deviceStats = d.stats || { total: 0, activeRate: 0, usageRate: 0, warningRate: 0 }
          this.warningRates = d.warningRates || []
          this.$nextTick(() => this.initDeviceCharts())
        }
      } catch (e) {
        this.deviceStats = { total: 0, activeRate: 0, usageRate: 0, warningRate: 0 }
        this.warningRates = []
        this.$nextTick(() => this.initDeviceCharts())
      }
    },
    async fetchWarningEvents() {
      try {
        const res = await getWarningEvents()
        if (res.code === 200) {
          this.warningEvents = res.data || []
          this.$nextTick(() => this.startAutoScroll())
        }
      } catch (e) {
        this.warningEvents = []
      }
    },

    // ── ECharts ──
    initCheckCountChart() {
      const dom = document.getElementById('checkCountChart')
      if (!dom) return
      if (this.charts.checkCount) this.charts.checkCount.dispose()
      const chart = echarts.init(dom)
      this.charts.checkCount = chart

      const pieData = this.metricList.map(m => ({
        value: this.checkData[m.key] || 0,
        name: m.label,
        itemStyle: { color: m.color }
      }))

      chart.setOption({
        backgroundColor: 'transparent',
        tooltip: {
          trigger: 'item',
          backgroundColor: 'rgba(10,20,50,0.9)',
          borderColor: '#00d4ff',
          textStyle: { color: '#fff' },
          formatter: '{b}: {c} ({d}%)'
        },
        legend: {
          orient: 'vertical',
          right: '2%',
          top: 'center',
          itemWidth: 10,
          itemHeight: 10,
          textStyle: { color: '#8ba6c8', fontSize: 11 }
        },
        series: [{
          type: 'pie',
          radius: ['42%', '65%'],
          center: ['36%', '50%'],
          avoidLabelOverlap: true,
          minAngle: 4,
          data: pieData,
          emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,212,255,0.5)' }, scaleSize: 4 },
          label: { show: false },
          labelLine: { show: false }
        }]
      })
    },

    initTop5Chart() {
      const dom = document.getElementById('top5Chart')
      if (!dom) return
      if (this.charts.top5) this.charts.top5.dispose()
      const chart = echarts.init(dom)
      this.charts.top5 = chart

      if (!this.top5Data || !this.top5Data.length) {
        chart.setOption({ title: { text: '暂无数据', left: 'center', top: 'center', textStyle: { color: '#8ba6c8', fontSize: 13 } } })
        return
      }
      const names = this.top5Data.map((item, i) => `No.${i + 1}  ${item.name}`)
      const vals = this.top5Data.map(item => item.count || 0)
      const maxVal = Math.max(...vals, 1)

      chart.setOption({
        backgroundColor: 'transparent',
        grid: { left: '30%', right: '14%', top: '8%', bottom: '8%' },
        tooltip: {
          trigger: 'axis',
          backgroundColor: 'rgba(10,20,50,0.9)',
          borderColor: '#00d4ff',
          textStyle: { color: '#fff' }
        },
        xAxis: {
          type: 'value',
          axisLine: { lineStyle: { color: '#1a4d8f' } },
          axisLabel: { color: '#8ba6c8', fontSize: 10 },
          splitLine: { lineStyle: { color: 'rgba(26,77,143,0.4)', type: 'dashed' } }
        },
        yAxis: {
          type: 'category',
          data: names,
          inverse: true,
          axisLine: { lineStyle: { color: '#1a4d8f' } },
          axisLabel: { color: '#8ba6c8', fontSize: 11, width: 90, overflow: 'truncate' }
        },
        series: [{
          type: 'bar',
          data: vals.map((v, i) => ({
            value: v,
            itemStyle: {
              color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                { offset: 0, color: i === 0 ? '#ff9800' : '#00d4ff' },
                { offset: 1, color: i === 0 ? '#ffcc02' : '#00ffff' }
              ]),
              borderRadius: [0, 4, 4, 0]
            }
          })),
          barWidth: 14,
          barMaxWidth: 20,
          label: { show: true, position: 'right', color: '#00d4ff', fontSize: 11, formatter: '{c}' },
          showBackground: true,
          backgroundStyle: { color: 'rgba(26,77,143,0.15)', borderRadius: [0, 4, 4, 0] }
        }]
      })
    },

    initDeviceCharts() {
      this.initGauge('activeRateChart',  this.deviceStats.activeRate  || 0)
      this.initGauge('usageRateChart',   this.deviceStats.usageRate   || 0)
      this.initGauge('warningRateChart', this.deviceStats.warningRate || 0)
    },
    initGauge(id, value) {
      const dom = document.getElementById(id)
      if (!dom) return
      if (this.charts[id]) this.charts[id].dispose()
      const chart = echarts.init(dom)
      this.charts[id] = chart
      const color = value >= 70 ? '#67C23A' : value >= 40 ? '#E6A23C' : '#F56C6C'
      chart.setOption({
        backgroundColor: 'transparent',
        series: [{
          type: 'gauge',
          startAngle: 200, endAngle: -20,
          radius: '88%', center: ['50%', '62%'],
          min: 0, max: 100,
          axisLine: {
            lineStyle: {
              width: 10,
              color: [[value / 100, color], [1, 'rgba(26,77,143,0.3)']]
            }
          },
          pointer: { show: false },
          axisTick: { show: false },
          splitLine: { show: false },
          axisLabel: { show: false },
          detail: {
            valueAnimation: true,
            formatter: '{value}%',
            color,
            fontSize: 14,
            fontWeight: 'bold',
            fontFamily: 'Consolas',
            offsetCenter: [0, '10%']
          },
          data: [{ value }]
        }]
      })
    },

    // ── 辅助方法 ──
    getWarningIcon(name) {
      const map = {
        '压力预警率': 'MagicStick',
        '睡眠预警率': 'Moon',
        '体温预警率': 'Sunny',
        '心率预警率': 'Monitor',
        '血氧预警率': 'FirstAidKit'
      }
      return map[name] || 'Warning'
    },
    getWarnColor(rate) {
      if (rate >= 20) return '#ff5252'
      if (rate >= 10) return '#ffd200'
      return '#38ef7d'
    },
    getWarnGradient(rate) {
      if (rate >= 20) return 'linear-gradient(90deg, #ff5252, #ff1744)'
      if (rate >= 10) return 'linear-gradient(90deg, #ffd200, #ff9800)'
      return 'linear-gradient(90deg, #00d4ff, #38ef7d)'
    },
    getWarnTagClass(rate) {
      if (rate >= 20) return 'tag-danger'
      if (rate >= 10) return 'tag-warn'
      return 'tag-ok'
    },
    getWarnTagLabel(rate) {
      if (rate >= 20) return '偏高'
      if (rate >= 10) return '注意'
      return '正常'
    },
    formatTimeAgo(timestamp) {
      if (!timestamp) return ''
      const diff = Date.now() - new Date(timestamp).getTime()
      const mins = Math.floor(diff / 60000)
      if (mins < 1) return '刚刚'
      if (mins < 60) return `${mins}分钟前`
      const h = Math.floor(mins / 60)
      if (h < 24) return `${h}小时前`
      return dayjs(timestamp).format('MM-DD HH:mm')
    },

    // ── 自动滚动 ──
    startAutoScroll() {
      if (this.pageScrollInterval) clearInterval(this.pageScrollInterval)
      this.$nextTick(() => {
        const list = this.$refs.warningList
        if (!list) return
        let scrollTop = 0
        this.pageScrollInterval = setInterval(() => {
          const max = list.scrollHeight - list.clientHeight
          if (max <= 0) return
          if (scrollTop >= max) {
            setTimeout(() => {
              scrollTop = 0
              list.scrollTop = 0
              if (this.warningTotalPages > 1) {
                this.warningCurrentPage = this.warningCurrentPage < this.warningTotalPages
                  ? this.warningCurrentPage + 1 : 1
              }
            }, 1200)
          } else {
            scrollTop += 1
            list.scrollTop = scrollTop
          }
        }, 40)
      })
    },

    // ── 定时刷新 ──
    startAutoRefresh() {
      this.refreshTimer = setInterval(() => this.fetchData(), 30000)
    },

    // ── 缩放适配 ──
    setScale() {
      const el = this.$refs.dmScale
      if (!el) return
      // 用父容器实际宽度，自动适配 sidebar 展开/收起
      const container = el.parentElement || el
      const vw = container.clientWidth || window.innerWidth
      const vh = window.innerHeight - 50  // 减去顶部导航栏
      const scale = Math.max(0.4, Math.min(2, Math.min(vw / 1920, vh / 1030)))
      el.style.transformOrigin = 'top left'
      el.style.transform = `scale(${scale})`
      el.style.width  = `${(1 / scale) * 100}%`
      el.style.height = `${(1 / scale) * 100}vh`
    },
    handleResize() {
      clearTimeout(this.resizeTimer)
      this.resizeTimer = setTimeout(() => {
        this.setScale()
        this.$nextTick(() => {
          Object.values(this.charts).forEach(c => c && c.resize && c.resize())
        })
      }, 200)
    }
  }
}
</script>

