.dm-brand-title {
  font-size: 16px;
  font-weight: 700;
  color: $bright;
  letter-spacing: 2px;
  white-space: nowrap;
}
.dm-brand-time {
  font-size: 11px;
  color: $dim;
  margin-top: 3px;
  font-family: 'Consolas', monospace;
}

// ── KPI 卡片行 ──
.dm-header-kpis {
  display: flex;
  gap: 12px;
  flex: 1;
  justify-content: flex-end;
}

.dm-kpi {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 16px;
  height: 50px;
  background: rgba(0, 30, 70, 0.6);
  border: 1px solid $border;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
  min-width: 140px;
  transition: border-color 0.3s;

  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
  }
  &.kpi-blue::after  { background: linear-gradient(90deg, $accent, transparent); }
  &.kpi-red::after   { background: linear-gradient(90deg, $danger, transparent); }
  &.kpi-green::after { background: linear-gradient(90deg, $success, transparent); }
  &.kpi-orange::after{ background: linear-gradient(90deg, #ff9800, transparent); }
}

.dm-kpi-icon {
  color: $accent;
  .kpi-red & { color: $danger; }
  .kpi-green & { color: $success; }
  .kpi-orange & { color: #ff9800; }
  flex-shrink: 0;
}

.dm-kpi-body { flex: 1; }
.dm-kpi-val {
  font-size: 20px;
  font-weight: 700;
  color: $bright;
  font-family: 'Consolas', monospace;
  line-height: 1.1;
}
.dm-kpi-label {
  font-size: 11px;
  color: $dim;
  margin-top: 2px;
}

.dm-kpi-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
  animation: dotBlink 1.5s ease-in-out infinite;
  &.dot-blue   { background: $accent; box-shadow: 0 0 6px $accent; }
  &.dot-red    { background: $danger; box-shadow: 0 0 6px $danger; }
  &.dot-green  { background: $success; box-shadow: 0 0 6px $success; }
  &.dot-orange { background: #ff9800; box-shadow: 0 0 6px #ff9800; }
}
@keyframes dotBlink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.2; }
}

// ── 主网格 ──
.dm-grid {
  flex: 1;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr 1.45fr 1fr;
  grid-template-rows: 1fr 1fr;
  grid-template-areas:
    "a1 center b1"
    "a2 center b2";
  gap: 10px;
  padding: 10px;
}

// ── 卡片基础样式 ──
.dm-card {
  background: $panel;
  border: 1px solid $border;
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
  backdrop-filter: blur(8px);

  &::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0,212,255,0.4), transparent);
  }
  position: relative;
}

// ── 卡片头部 ──
.dm-card-hd {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px 8px;
  font-size: 13px;
  font-weight: 600;
  color: $text;
  border-bottom: 1px solid rgba(0, 212, 255, 0.1);
  flex-shrink: 0;
}

.dm-hd-bar {
  display: inline-block;
  width: 3px;
  height: 14px;
  background: $accent;
  border-radius: 2px;
  flex-shrink: 0;
}

.dm-hd-sub {
  font-size: 11px;
  color: $dim;
  font-weight: 400;
  margin-left: auto;
}

.dm-badge-count {
  margin-left: auto;
  background: rgba(255, 82, 82, 0.2);
  border: 1px solid rgba(255, 82, 82, 0.4);
  color: $danger;
  font-size: 11px;
  font-weight: 700;
  padding: 1px 8px;
  border-radius: 10px;
}

// ── 通用图表容器 ──
.dm-chart {
  flex: 1;
  width: 100%;
  min-height: 0;
}

// ═══════════ A1: 检测概览 ═══════════
.dm-donut-wrap {
  flex: 1;
  position: relative;
  min-height: 0;
  display: flex;
}
.dm-donut-center {
  position: absolute;
  left: 33%;
  top: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
}
.dm-donut-num {
  font-size: 18px;
  font-weight: 700;
  color: $accent;
  font-family: 'Consolas', monospace;
}
.dm-donut-lbl {
  font-size: 10px;
  color: $dim;
}

.dm-metric-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 4px 8px;
  padding: 6px 14px 10px;
  flex-shrink: 0;
}
.dm-metric {
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  color: $dim;
}
.dm-metric-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}
.dm-metric-name { flex: 1; white-space: nowrap; }
.dm-metric-val {
  color: $bright;
  font-family: 'Consolas', monospace;
  font-weight: 600;
}

// ═══════════ CENTER: 监测中心 ═══════════
.dm-card-center {
  grid-area: center;
}

.body-model-3d-container {
  position: relative;
  flex: 0 0 62%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.human-body-3d {
  position: relative;
  width: 100%;
  height: 100%;

  &.rotating-body.miner-model {
    animation: minerSway 6s ease-in-out infinite;
    transform-style: preserve-3d;
  }
  &.miner-model {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;

    .scan-ring {
      position: absolute;
      left: 50%; top: 50%;
      width: 240px; height: 240px;
      border: 1px solid rgba(0, 229, 255, 0.5);
      border-radius: 50%;
      box-shadow: 0 0 8px rgba(0, 229, 255, 0.15);
      animation: scanRingTilt1 10s linear infinite;
      &.scan-ring-2 {
        width: 300px; height: 300px;
        border-color: rgba(0, 212, 255, 0.3);
        animation: scanRingTilt2 14s linear infinite;
      }
      &.scan-ring-3 {
        width: 360px; height: 360px;
        border-color: rgba(0, 136, 204, 0.2);
        animation: scanRingTilt3 18s linear infinite;
      }
    }
    .miner-body {
      position: relative;
      width: 160px;
      height: 320px;
      animation: minerFloat 3s ease-in-out infinite;
    }
  }
}

.miner-svg {
  width: 100%; height: 100%;
  filter: drop-shadow(0 0 14px rgba(0, 180, 255, 0.5));
}
.mf-headlamp  { animation: mfLampBlink 2s ease-in-out infinite; }
.mf-beam      { animation: mfBeamPulse 2s ease-in-out infinite; }
.mf-reflector { animation: mfReflectorGlow 2.5s ease-in-out infinite; }
.mf-reflector-2 { animation-delay: 0.5s; }
.mf-warning   { animation: mfWarningBlink 1s ease-in-out infinite; }
.mf-warning-2 { animation-delay: 0.5s; }
.mf-hp { transform-box: fill-box; transform-origin: center; animation: mfHpPulse 2s ease-in-out infinite; }
.mf-hp-2 { animation-delay: 0.4s; }
.mf-hp-3 { animation-delay: 0.8s; }
.mf-hp-4 { animation-delay: 1.2s; }
.mf-data-line { animation: mfDashFlow 1.5s linear infinite; }
.mf-dl-2 { animation-delay: 0.3s; }
.mf-dl-3 { animation-delay: 0.6s; }
.mf-scan-line { animation: mfScanDown 4s linear infinite; }

@keyframes mfLampBlink   { 0%,88%,100%{opacity:1} 93%{opacity:0.2} }
@keyframes mfBeamPulse   { 0%,88%,100%{opacity:1} 93%{opacity:0.15} }
@keyframes mfReflectorGlow { 0%,100%{opacity:0.85} 50%{opacity:1} }
@keyframes mfWarningBlink  { 0%,100%{opacity:1} 50%{opacity:0.15} }
@keyframes mfHpPulse     { 0%,100%{transform:scale(1);opacity:0.9} 50%{transform:scale(1.5);opacity:0.5} }
@keyframes mfDashFlow    { to{stroke-dashoffset:-16} }
@keyframes mfScanDown    { 0%{transform:translateY(0);opacity:0} 8%{opacity:1} 92%{opacity:1} 100%{transform:translateY(310px);opacity:0} }
@keyframes minerFloat    { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-6px) scale(1.02)} }
@keyframes scanRingTilt1 { from{transform:translate(-50%,-50%) rotateX(72deg) rotateZ(0)} to{transform:translate(-50%,-50%) rotateX(72deg) rotateZ(360deg)} }
@keyframes scanRingTilt2 { from{transform:translate(-50%,-50%) rotateX(65deg) rotateZ(0)} to{transform:translate(-50%,-50%) rotateX(65deg) rotateZ(-360deg)} }
@keyframes scanRingTilt3 { from{transform:translate(-50%,-50%) rotateX(78deg) rotateZ(0)} to{transform:translate(-50%,-50%) rotateX(78deg) rotateZ(360deg)} }
@keyframes minerSway     { 0%{transform:perspective(800px) rotateY(-25deg)} 50%{transform:perspective(800px) rotateY(25deg)} 100%{transform:perspective(800px) rotateY(-25deg)} }

.base-platform {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  width: 180px;
  height: 40px;
  .platform-ring {
    position: absolute; width:100%; height:100%;
    border: 2px solid rgba(0,212,255,0.5);
    border-radius: 50%;
    transform: perspective(500px) rotateX(75deg);
    animation: platformPulse 3s ease-in-out infinite;
  }
  .platform-glow {
    position: absolute; width:120%; height:120%; left:-10%; top:-10%;
    background: radial-gradient(circle, rgba(0,212,255,0.25) 0%, transparent 70%);
    border-radius: 50%;
    animation: glowPulse 2s ease-in-out infinite;
  }
}
@keyframes platformPulse { 0%,100%{opacity:0.6;transform:perspective(500px) rotateX(75deg) scale(1)} 50%{opacity:1;transform:perspective(500px) rotateX(75deg) scale(1.1)} }
@keyframes glowPulse     { 0%,100%{opacity:0.3} 50%{opacity:0.7} }

// ── 四角数据点 ──
.pyramid-data {
  position: absolute;
  z-index: 10;
