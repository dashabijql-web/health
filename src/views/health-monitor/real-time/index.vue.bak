<template>
  <div class="health-monitor-container">
    <div class="health-monitor-header">
      <h1 class="main-title">实时健康监控</h1>
      <div class="header-time">{{ currentTime }}</div>
    </div>

    <div class="realtime-content">
      <!-- 第一行：顶部6个平均数据卡片 -->
      <el-row :gutter="20" class="mb-20">
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon heart">
              <el-icon><QuestionFilled /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.avgHeartRate }}</div>
              <div class="card-label">最近24h平均心率(次/分)</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon oxygen">
              <el-icon><TrendCharts /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.avgBloodOxygen }}%</div>
              <div class="card-label">最近24h平均血氧</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon steps">
              <el-icon><Wallet /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.avgSteps }}</div>
              <div class="card-label">最近24h平均步数</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon temperature">
              <el-icon><Sunrise /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.avgTemperature }}°C</div>
              <div class="card-label">最近24h平均体温</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon sleep">
              <el-icon><Moon /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.avgSleep }}h</div>
              <div class="card-label">最近24h平均睡眠</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon warning">
              <el-icon><Warning /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value">{{ overview.todayWarningCount }}</div>
              <div class="card-label">最近24h预警数量</div>
            </div>
          </div>
        </el-col>
      </el-row>

      <!-- 第二行：实时统计6个卡片 -->
      <el-row :gutter="20" class="mb-20">
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon online-users">
              <el-icon><User /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value online">{{ statistics.onlineUsers }}</div>
              <div class="card-label">在线用户</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon total-users">
              <el-icon><Avatar /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value total">{{ statistics.totalUsers }}</div>
              <div class="card-label">总用户</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon week-records">
              <el-icon><Calendar /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value week">{{ statistics.weekRecords }}</div>
              <div class="card-label">近七天记录</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon today-records">
              <el-icon><Timer /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value today">{{ statistics.todayRecords }}</div>
              <div class="card-label">24h记录</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon online-rate">
              <el-icon><PieChart /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value rate">{{ statistics.onlineRate }}%</div>
              <div class="card-label">在线率</div>
            </div>
          </div>
        </el-col>
        <el-col :span="4">
          <div class="unified-card">
            <div class="card-icon normal-rate">
              <el-icon><SuccessFilled /></el-icon>
            </div>
            <div class="card-content">
              <div class="card-value normal">{{ statistics.normalRate }}%</div>
              <div class="card-label">正常率</div>
            </div>
          </div>
        </el-col>
      </el-row>

      <!-- 第三行：在线用户列表 -->
      <el-row :gutter="20">
        <el-col :span="24">
          <div class="tech-card user-list-card">
            <div class="card-header">
              <span class="card-title">在线用户列表</span>
              <div class="header-controls">
                <!-- 搜索区域 -->
                <div class="search-area">
                  <el-input
                    v-model="searchForm.name"
                    placeholder="请输入姓名"
                    clearable
                    class="search-input"
                    @clear="handleSearch">
</el-input>
                  <el-select
                    v-model="searchForm.dept"
                    placeholder="请选择部门"
                    clearable
                    class="search-select"
                    @change="handleSearch">
                    <el-option label="全部部门" value=""></el-option>
                    <el-option
                      v-for="dept in deptList"
                      :key="dept"
                      :label="dept"
                      :value="dept">
                    </el-option>
                  </el-select>
                  <button class="search-btn" @click="handleSearch">
                    <el-icon><Search /></el-icon> 搜索
                  </button>
                  <button class="reset-btn" @click="handleReset">
                    <el-icon><RefreshLeft /></el-icon> 重置
                  </button>
                </div>
                
                <!-- 功能按钮区域 -->
                <div class="function-btns">
                  <button class="control-btn" @click="toggleAutoScroll">
                    <el-icon><component :is="autoScrollEnabled ? 'VideoPause' : 'VideoPlay'" /></el-icon>
                    {{ autoScrollEnabled ? '暂停' : '滚动' }}
                  </button>
                  <button class="refresh-btn" @click="refreshOnlineUsers">
                    <el-icon><Refresh /></el-icon> 刷新
                  </button>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="table-wrapper" ref="tableWrapper" @mouseenter="pauseAutoScroll" @mouseleave="resumeAutoScroll">
                <el-table
                  :data="paginatedUserList" 
                  border 
                  style="width: 100%"
                  :header-cell-style="{
                    background: 'rgba(0, 50, 100, 0.6)',
                    color: '#00d4ff',
                    borderColor: 'rgba(0, 212, 255, 0.2)',
                    fontSize: '14px',
                    fontWeight: 'bold'
                  }"
                  :cell-style="{
                    background: 'rgba(0, 30, 60, 0.4)',
                    borderColor: 'rgba(0, 212, 255, 0.1)',
                    color: '#a8c5e6',
                    fontSize: '13px'
                  }">
                  <el-table-column prop="userName" label="姓名" width="120" align="center">
                    <template #default="scope">
                      <span style="color: #00d4ff; font-weight: 500;">{{ scope.row.userName || '--' }}</span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="userCode" label="工号" width="120" align="center">
                    <template #default="scope">
                      <span style="color: #8ba6c8">{{ scope.row.userCode || '--' }}</span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="deptName" label="部门" width="150" align="center">
                    <template #default="scope">
                      <span style="color: #8ba6c8">{{ scope.row.deptName || '--' }}</span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="heartRate" label="心率" width="100" align="center">
                    <template #default="scope">
                      <span :style="{color: getHeartRateColor(scope.row.heartRate), fontWeight: '500'}">
                        {{ scope.row.heartRate || '--' }}
                      </span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="bloodOxygen" label="血氧" width="100" align="center">
                    <template #default="scope">
                      <span :style="{color: getBloodOxygenColor(scope.row.bloodOxygen), fontWeight: '500'}">
                        {{ scope.row.bloodOxygen ? scope.row.bloodOxygen + '%' : '--' }}
                      </span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="steps" label="步数" width="100" align="center">
                    <template #default="scope">
                      <span style="color: #66BB6A; font-weight: 500;">{{ scope.row.steps || 0 }}</span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="temperature" label="体温" width="100" align="center">
                    <template #default="scope">
                      <span :style="{color: getTemperatureColor(scope.row.temperature), fontWeight: '500'}">
                        {{ scope.row.temperature ? scope.row.temperature + '°C' : '--' }}
                      </span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="sleepHours" label="睡眠" width="100" align="center">
                    <template #default="scope">
                      <span style="color: #4FC3F7; font-weight: 500;">{{ scope.row.sleepHours ? scope.row.sleepHours + 'h' : '--' }}</span>
                    </template>
                  </el-table-column>
                  <el-table-column prop="status" label="状态" width="100" align="center">
                    <template #default="scope">
                      <el-tag :type="scope.row.status === 'normal' ? 'success' : 'warning'" size="small">
                        {{ scope.row.status === 'normal' ? '正常' : '预警' }}
                      </el-tag>
                    </template>
                  </el-table-column>
                  <el-table-column prop="lastUpdate" label="最后更新" align="center">
                    <template #default="scope">
                      <span style="color: #8ba6c8">{{ formatTableTime(scope.row) }}</span>
                    </template>
                  </el-table-column>
                </el-table>
              </div>
              <!-- 分页器 -->
              <div class="table-pagination">
                <button
                  class="page-btn"
                  :disabled="currentPage === 1"
                  @click="currentPage = 1">
                  首页
                </button>
                <button
                  class="page-btn"
                  :disabled="currentPage === 1"
                  @click="currentPage--">
                  ‹
                </button>
                <span class="page-info">{{ currentPage }} / {{ totalPages }}</span>
                <button
                  class="page-btn"
                  :disabled="currentPage === totalPages"
                  @click="currentPage++">
                  ›
                </button>
                <button
                  class="page-btn"
                  :disabled="currentPage === totalPages"
                  @click="currentPage = totalPages">
                  末页
                </button>
                <span class="page-total">共 {{ filteredUserList.length }} 条</span>
              </div>
            </div>
          </div>
        </el-col>
      </el-row>
    </div>
  </div>
</template>

<script>
import dayjs from 'dayjs'
import {
  getRealtimeOverview,
  getOnlineUsers,
  getRealtimeStatistics
} from '@/api/realtime'

export default {
  name: 'RealtimeMonitor',
  data() {
    return {
      currentTime: '',
      overview: {
        avgHeartRate: 0,
        avgBloodOxygen: 0,
        avgSteps: 0,
        avgTemperature: 0,
        avgSleep: 0,
        todayWarningCount: 0
      },
      onlineUsers: {
        list: [],
        total: 0
      },
      statistics: {
        onlineUsers: 0,
        totalUsers: 0,
        weekRecords: 0,
        todayRecords: 0,
        onlineRate: 0,
        normalRate: 0
      },
      // 搜索表单
      searchForm: {
        name: '',
        dept: ''
      },
      // 部门列表
      deptList: [],
      // 分页
      currentPage: 1,
      pageSize: 20,
      refreshTimer: null,
      autoScrollTimer: null,
      autoScrollEnabled: true,
      scrollPaused: false,
      resizeTimer: null
    }
  },
  computed: {
    // 过滤后的用户列表（不分页）
    filteredUserList() {
      let list = this.onlineUsers.list || []
      
      // 按姓名过滤
      if (this.searchForm.name) {
        const name = this.searchForm.name.trim().toLowerCase()
        list = list.filter(user => {
          const userName = (user.userName || '').toLowerCase()
          return userName.includes(name)
        })
      }
      
      // 按部门过滤
      if (this.searchForm.dept) {
        list = list.filter(user => user.deptName === this.searchForm.dept)
      }

      return list
    },
    // 分页后的用户列表
    paginatedUserList() {
      const start = (this.currentPage - 1) * this.pageSize
      const end = start + this.pageSize
      return this.filteredUserList.slice(start, end)
    },
    // 总页数
    totalPages() {
      return Math.ceil(this.filteredUserList.length / this.pageSize)
    }
  },
  mounted() {
    this.initTime()
    this.fetchData()
    this.autoRefresh()
    this.startAutoScroll()
    this.setRootFontSize()
    window.addEventListener('resize', this.handleResize)
  },
  beforeUnmount() {
    if (this.refreshTimer) {
      clearInterval(this.refreshTimer)
    }
    if (this.autoScrollTimer) {
      clearInterval(this.autoScrollTimer)
    }
    if (this.resizeTimer) {
      clearTimeout(this.resizeTimer)
    }
    window.removeEventListener('resize', this.handleResize)
  },
  methods: {
    initTime() {
      this.updateTime()
      setInterval(this.updateTime, 1000)
    },
    updateTime() {
      this.currentTime = dayjs().format('YYYY-MM-DD HH:mm:ss')
    },
    
    async fetchData() {
      try {
        await Promise.all([
          this.fetchOverview(),
          this.fetchOnlineUsers(),
          this.fetchStatistics()
        ])
      } catch (error) {
        console.error('获取数据失败:', error)
        this.$message.error('获取数据失败')
      }
    },

    async fetchOverview() {
      const res = await getRealtimeOverview()
      if (res.code === 200) {
        this.overview = res.data
      }
    },

    async fetchOnlineUsers() {
      const res = await getOnlineUsers(1, 10000)
      if (res.code === 200) {
        this.onlineUsers = res.data
        // 提取部门列表
        this.extractDeptList()
      }
    },

    async fetchStatistics() {
      const res = await getRealtimeStatistics()
      if (res.code === 200) {
        this.statistics = res.data
      }
    },

    // 提取部门列表（去重）
    extractDeptList() {
      const depts = new Set()
      this.onlineUsers.list.forEach(user => {
        if (user.deptName) {
          depts.add(user.deptName)
        }
      })
      this.deptList = Array.from(depts).sort()
    },

    autoRefresh() {
      this.refreshTimer = setInterval(() => {
        this.fetchOverview()
        this.fetchOnlineUsers()
        this.fetchStatistics()
      }, 5000)
    },

    refreshOnlineUsers() {
      this.fetchOnlineUsers()
      this.$message.success('刷新成功')
    },

    // 搜索处理
    handleSearch() {
      // 重置到第一页
      this.currentPage = 1
      // 搜索时暂停滚动
      if (this.autoScrollEnabled) {
        this.scrollPaused = true
        setTimeout(() => {
          this.scrollPaused = false
        }, 3000) // 3秒后恢复滚动
      }
    },

    // 重置搜索
    handleReset() {
      this.searchForm = {
        name: '',
        dept: ''
      }
      // 重置到第一页
      this.currentPage = 1
      this.$message.info('已重置搜索条件')
    },

    // 自动滚动相关方法
    startAutoScroll() {
      if (this.autoScrollTimer) {
        clearInterval(this.autoScrollTimer)
      }
      
      this.autoScrollTimer = setInterval(() => {
        if (this.autoScrollEnabled && !this.scrollPaused) {
          this.scrollTable()
        }
      }, 50)
    },

    scrollTable() {
      const wrapper = this.$refs.tableWrapper
      if (!wrapper) return

      const scrollHeight = wrapper.scrollHeight
      const clientHeight = wrapper.clientHeight
      const maxScroll = scrollHeight - clientHeight

      if (maxScroll <= 0) return

      wrapper.scrollTop += 1

      if (wrapper.scrollTop >= maxScroll) {
        setTimeout(() => {
          wrapper.scrollTop = 0
        }, 2000)
      }
    },

    toggleAutoScroll() {
      this.autoScrollEnabled = !this.autoScrollEnabled
      if (this.autoScrollEnabled) {
        this.$message.success('已开启自动滚动')
      } else {
        this.$message.info('已暂停自动滚动')
      }
    },

    pauseAutoScroll() {
      this.scrollPaused = true
    },

    resumeAutoScroll() {
      this.scrollPaused = false
    },

    getHeartRateColor(rate) {
      if (!rate) return '#8ba6c8'
      if (rate < 60 || rate > 100) return '#E6A23C'
      if (rate < 50 || rate > 120) return '#F56C6C'
      return '#67C23A'
    },

    getBloodOxygenColor(oxygen) {
      if (!oxygen) return '#8ba6c8'
      if (oxygen < 90) return '#F56C6C'
      if (oxygen < 95) return '#E6A23C'
      return '#67C23A'
    },

    getTemperatureColor(temp) {
      if (!temp) return '#8ba6c8'
      if (temp < 36.0 || temp > 37.5) return '#E6A23C'
      if (temp < 35.0 || temp > 38.0) return '#F56C6C'
      return '#67C23A'
    },

    formatTableTime(row) {
      if (!row.lastUpdate) return ''
      return dayjs(row.lastUpdate).format('HH:mm:ss')
    },

    // 响应式缩放设置（zoom方案）
    setRootFontSize() {
      const container = document.querySelector('.health-monitor-container')
      if (!container) return

      const baseWidth = 1920
      const clientWidth = document.documentElement.clientWidth || window.innerWidth
      let scale = clientWidth / baseWidth
      scale = Math.max(0.5, Math.min(1.5, scale))

      container.style.zoom = scale
    },

    // 窗口大小变化处理（防抖）
    handleResize() {
      if (this.resizeTimer) {
        clearTimeout(this.resizeTimer)
      }

      this.resizeTimer = setTimeout(() => {
        this.setRootFontSize()
      }, 200)
    }
  }
}
</script>

<style lang="scss" scoped>
@import '@/styles/health-monitor.scss';

.mb-20 {
  margin-bottom: 20px;
}

.realtime-content {
  padding-bottom: 20px;
}

