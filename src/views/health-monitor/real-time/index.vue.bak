  padding: 20px 15px;
  min-height: 110px;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);

  &:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0, 212, 255, 0.3);
    border-color: rgba(0, 212, 255, 0.5);
    background: linear-gradient(135deg, rgba(0, 60, 120, 0.5), rgba(0, 40, 80, 0.7));
  }

  .card-icon {
    width: 50px;
    height: 50px;
