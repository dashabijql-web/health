    i {
      font-size: 24px;
    }

    &.heart {
      background: rgba(239, 68, 68, 0.2);
      i { color: #ef4444; }
    }

    &.oxygen {
      background: rgba(59, 130, 246, 0.2);
      i { color: #3b82f6; }
    }

    &.steps {
      background: rgba(34, 197, 94, 0.2);
      i { color: #22c55e; }
    }

    &.temperature {
      background: rgba(249, 115, 22, 0.2);
      i { color: #f97316; }
    }

    &.sleep {
      background: rgba(168, 85, 247, 0.2);
      i { color: #a855f7; }
    }

    &.warning {
      background: rgba(230, 162, 60, 0.2);
      i { color: #E6A23C; }
    }

    &.online-users {
      background: rgba(34, 197, 94, 0.2);
      i { color: #22c55e; }
    }

    &.total-users {
      background: rgba(59, 130, 246, 0.2);
      i { color: #3b82f6; }
    }

    &.week-records {
      background: rgba(168, 85, 247, 0.2);
      i { color: #a855f7; }
    }

    &.today-records {
      background: rgba(249, 115, 22, 0.2);
      i { color: #f97316; }
    }

    &.online-rate {
      background: rgba(103, 194, 58, 0.2);
      i { color: #67C23A; }
    }

    &.normal-rate {
      background: rgba(103, 194, 58, 0.2);
      i { color: #67C23A; }
    }
  }

  .card-content {
    flex: 1;
    text-align: left;

    .card-value {
      font-size: 28px;
      font-weight: bold;
      font-family: 'Consolas', monospace;
      color: #00d4ff;
      margin-bottom: 5px;
      line-height: 1;

      &.online {
        color: #22c55e;
      }

      &.total {
        color: #3b82f6;
      }

      &.week {
        color: #a855f7;
      }

      &.today {
        color: #f97316;
      }

      &.rate {
        color: #67C23A;
      }

      &.normal {
        color: #67C23A;
      }
    }

    .card-label {
      font-size: 12px;
      color: #8ba6c8;
      line-height: 1.4;
    }
  }
}

// 在线用户列表卡片
.user-list-card {
  min-height: 500px;
  background: linear-gradient(135deg, rgba(0, 50, 100, 0.4), rgba(0, 30, 60, 0.6));
  border: 1px solid rgba(0, 212, 255, 0.3);
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
  }

  .search-area {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .function-btns {
    display: flex;
    gap: 10px;
  }
  
  .card-body {
  overflow: hidden;
}
  
  .table-wrapper {
    max-height: 600px;
    overflow-y: auto;
    overflow-x: hidden;
  }
}

// 搜索输入框样式
.search-input {
  width: 180px;
  
  :deep(.el-input__wrapper) {
    background: rgba(0, 30, 60, 0.6) !important;
    border: 1px solid rgba(0, 212, 255, 0.3) !important;
    box-shadow: 0 0 0 1px rgba(0, 212, 255, 0.3) !important;
  }
  :deep(.el-input__inner) {
    color: #a8c5e6;
    
    &::placeholder {
      color: #6b7b94;
